{
  "name": "youtube-downloader",
  "version": "2.9.0",
  "description": "A browser extension for downloading video and audio from YouTube.",
  "repository": "https://github.com/avi12/youtube-downloader",
  "author": "Avi <avi6106@gmail.com>",
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#scripts/*": "./scripts/*",
    "#dev-server/*": "./dev-server/*"
  },
  "scripts": {
    "dev": "bun run ytdl dev run",
    "dev:firefox": "bun run ytdl dev run --firefox",
    "ytdl": "cargo run --release --quiet --manifest-path tools/Cargo.toml --",
    "install:hyperv-multipass": "bun run ytdl release linux-vm install-prerequisites",
    "setup:linux-vm": "bun run ytdl release linux-vm setup",
    "dev:linux": "bun run ytdl release linux-vm dev",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "pack": "wxt zip",
    "pack:firefox": "wxt zip --browser firefox",
    "build:pack": "bun run build && bun run pack",
    "build:pack:firefox": "bun run build:firefox && bun run pack:firefox",
    "release": "bun run ytdl release package",
    "postinstall": "wxt prepare",
    "lint": "avi12-lint",
    "compile": "tsrs --noEmit",
    "assets:check": "tsrs --noEmit -p tools/assets/tsconfig.json",
    "svelte-check": "avi12-svelte-check --tsconfig ./tsconfig.json",
    "lint:fix": "avi12-lint --fix",
    "fallow": "fallow audit --base HEAD",
    "dev-server:test": "cargo test --manifest-path dev-server/Cargo.toml",
    "tools:test": "cargo test --manifest-path tools/Cargo.toml"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/core-nosimd": "npm:@ffmpeg/core@0.12.0",
    "@ffmpeg/types": "^0.12.4",
    "@ffmpeg/util": "^0.12.2",
    "@webext-core/messaging": "^4.0.0",
    "fflate": "^0.8.3",
    "googlevideo": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.51.0",
    "@puppeteer/browsers": "^3.2.4",
    "@stylistic/stylelint-plugin": "^5.3.1",
    "@types/ws": "^8.18.2",
    "@wxt-dev/module-svelte": "^2.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fallow": "^3.42.0",
    "globals": "^17.13.0",
    "lint-config": "github:avi12/lint-config#v0.12.0",
    "oxfmt": "^0.80.0",
    "oxlint": "1.90.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-ccb": "^3.32.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.9.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4",
    "ws": "^8.22.0",
    "wxt": "^0.21.4",
    "wxt-module-layers": "^1.3.0"
  },
  "packageManager": "bun@1.4.5",
  "patchedDependencies": {
    "@davestewart/wxt-utils@0.6.0": "patches/@davestewart__wxt-utils@0.6.0.patch",
    "@ffmpeg/core@0.12.0": "patches/@ffmpeg__core@0.12.0.patch",
    "@ffmpeg/core@0.12.10": "patches/@ffmpeg__core.patch"
  },
  "trustedDependencies": [
    "@ast-grep/cli",
    "esbuild",
    "spawn-sync"
  ]
}
