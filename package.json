{
  "name": "youtube-ffmpeg-lite",
  "version": "1.3.1",
  "description": "Run FFmpeg against a YouTube URL straight from the popup",
  "repository": "https://github.com/avi12/youtube-downloader",
  "author": "Avi <avi6106@gmail.com>",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "pack": "wxt zip",
    "build:pack": "pnpm build && pnpm run pack",
    "postinstall": "wxt prepare",
    "lint": "oxlint --type-aware --fix && eslint --fix",
    "compile": "tsc --noEmit",
    "stylelint": "stylelint \"src/**/*.{css,svelte}\" --fix",
    "svelte-check": "pnpx svelte-check",
    "dev": "wxt"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/core-nosimd": "npm:@ffmpeg/core@0.12.0",
    "@ffmpeg/types": "^0.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-plugin": "^5.3.1",
    "@wxt-dev/module-svelte": "^2.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-ccb": "^3.32.0",
    "svelte": "^5.57.2",
    "svelte-eslint-parser": "^1.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "wxt": "^0.21.4"
  }
}
