{
  "name": "youtube-downloader",
  "version": "2.9.0",
  "description": "A browser extension for downloading video and audio from YouTube.",
  "repository": "https://github.com/avi12/youtube-downloader",
  "author": "Avi <avi6106@gmail.com>",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev-server.ts",
    "dev:firefox": "tsx scripts/dev-server.ts --firefox",
    "install:hyperv-multipass": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/install-hyperv-multipass.ps1",
    "setup:linux-vm": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/setup-linux-vm.ps1",
    "dev:linux": "tsx scripts/linux-vm-dev.ts",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "pack": "wxt zip",
    "pack:firefox": "wxt zip --browser firefox",
    "build:pack": "pnpm build && pnpm run pack",
    "build:pack:firefox": "pnpm build:firefox && pnpm run pack:firefox",
    "release": "tsx scripts/release.ts",
    "postinstall": "wxt prepare",
    "lint": "avi12-lint",
    "compile": "tsc --noEmit",
    "svelte-check": "avi12-svelte-check --tsconfig ./tsconfig.json",
    "lint:fix": "avi12-lint --fix",
    "fallow": "fallow audit --base HEAD"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/core-nosimd": "npm:@ffmpeg/core@0.12.0",
    "@ffmpeg/types": "^0.12.4",
    "@ffmpeg/util": "^0.12.2",
    "@webext-core/messaging": "^4.0.0",
    "fflate": "^0.8.3",
    "googlevideo": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.2.4",
    "@stylistic/stylelint-plugin": "^5.3.1",
    "@types/ws": "^8.18.2",
    "@wxt-dev/module-svelte": "^2.0.5",
    "avi12-lint": "github:avi12/lint-config#v0.11.0&path:/packages/avi12-lint",
    "chokidar": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-config-avi12": "github:avi12/lint-config#v0.11.0&path:/packages/eslint-config",
    "eslint-plugin-svelte": "^3.23.1",
    "fallow": "^3.42.0",
    "fallow-config-avi12": "github:avi12/lint-config#v0.11.0&path:/packages/fallow-config",
    "oxlint": "1.90.0",
    "oxlint-config-avi12": "github:avi12/lint-config#v0.11.0&path:/packages/oxlint-config",
    "oxlint-plugin-naming": "github:avi12/lint-config#v0.11.0&path:/packages/oxlint-plugin-naming",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-avi12": "github:avi12/lint-config#v0.11.0&path:/packages/stylelint-config",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.9.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "web-ext-run": "^0.2.4",
    "ws": "^8.22.0",
    "wxt": "^0.21.4",
    "wxt-module-layers": "^1.3.0"
  }
}
