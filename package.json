{
  "name": "youtube-ffmpeg-lite",
  "version": "1.7.1",
  "description": "Run FFmpeg against a YouTube URL straight from the popup",
  "repository": "https://github.com/avi12/youtube-downloader",
  "author": "Avi <avi6106@gmail.com>",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "pack": "wxt zip",
    "build:mv2": "wxt build --mv2",
    "pack:mv2": "wxt zip --mv2",
    "pack:crx": "node scripts/pack-crx.mjs",
    "build:pack": "pnpm build && pnpm run pack",
    "release": "pnpm build && pnpm build:mv2 && pnpm run pack && pnpm run pack:mv2 && pnpm pack:crx",
    "postinstall": "wxt prepare",
    "lint": "avi12-lint",
    "compile": "tsc --noEmit",
    "svelte-check": "pnpx svelte-check",
    "dev": "wxt",
    "lint:fix": "avi12-lint --fix",
    "fallow": "fallow audit --base HEAD"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/core-nosimd": "npm:@ffmpeg/core@0.12.0",
    "@ffmpeg/types": "^0.12.4",
    "googlevideo": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stylistic/stylelint-plugin": "^5.3.1",
    "@wxt-dev/module-svelte": "^2.0.5",
    "@wxt-dev/webextension-polyfill": "^1.0.0",
    "avi12-lint": "github:avi12/lint-config#v0.4.10&path:/packages/avi12-lint",
    "crx3": "^2.0.0",
    "eslint": "^10.12.0",
    "eslint-config-avi12": "github:avi12/lint-config#v0.4.10&path:/packages/eslint-config",
    "eslint-plugin-svelte": "^3.23.1",
    "fallow": "^3.42.0",
    "fallow-config-avi12": "github:avi12/lint-config#v0.4.10&path:/packages/fallow-config",
    "oxlint": "1.90.0",
    "oxlint-config-avi12": "github:avi12/lint-config#v0.4.10&path:/packages/oxlint-config",
    "oxlint-plugin-naming": "github:avi12/lint-config#v0.4.10&path:/packages/oxlint-plugin-naming",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-avi12": "github:avi12/lint-config#v0.4.10&path:/packages/stylelint-config",
    "svelte": "^5.57.2",
    "svelte-eslint-parser": "^1.9.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "webextension-polyfill": "^0.12.0",
    "wxt": "^0.21.4"
  }
}
