{
  "$schema": "https://raw.githubusercontent.com/getfallow/fallow/main/schema/fallowrc.json",
  "entry": [
    "src/layers/*/entrypoints/*.content.ts",
    "src/layers/*/entrypoints/*/index.ts",
    "src/layers/*/entrypoints/*/index.content.ts",
    "src/layers/*/entrypoints/*/main.ts",
    "src/layers/*/layer.config.ts"
  ],
  "ignoreUnresolvedImports": [
    "#imports",
    "#background/**/*.svelte",
    "#popup/**/*.svelte",
    "#processing/**/*.svelte",
    "#youtube/**/*.svelte"
  ],
  "ignoreDependencies": [
    "@ffmpeg/core",
    "@ffmpeg/util",
    "@stylistic/stylelint-plugin",
    "@wxt-dev/module-svelte",
    "postcss-html",
    "ws"
  ]
}
