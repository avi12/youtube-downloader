{
  "$schema": "./node_modules/fallow/schema.json",
  "extends": [
    "./node_modules/lint-config/packages/fallow-config/fallow.json"
  ],
  "entry": [
    "src/layers/*/entrypoints/*.content.ts",
    "src/layers/*/entrypoints/*/index.ts",
    "src/layers/*/entrypoints/*/index.content.ts",
    "src/layers/*/entrypoints/*/main.ts",
    "src/layers/*/layer.config.ts"
  ],
  "ignoreUnresolvedImports": [
    "#imports",
    "#background/**/*.svelte",
    "#popup/**/*.svelte",
    "#processing/**/*.svelte",
    "#youtube/**/*.svelte"
  ],
  "ignoreDependencies": [
    "@ffmpeg/core",
    "@ffmpeg/util",
    "@wxt-dev/module-svelte",
    "postcss-html",
    "svelte-check",
    "ws"
  ],
  "ignorePatterns": [
    "dev-server/bindings/**",
    "tools/bindings/**"
  ]
}
