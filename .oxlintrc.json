{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/oxlint-config-avi12/wxt.json",
    "./node_modules/oxlint-plugin-naming/preset.json"
  ],
  "rules": {
    "naming/convention": [
      "error",
      {
        "presets": [
          "webextension-manifest",
          "webextension-messages",
          "hook-names"
        ],
        "allowedNames": [
          {
            "reason": "Marker flags the extension sets on the YouTube player object; the double underscore keeps them out of YouTube own names",
            "names": [
              "__ytdlAudioWatched",
              "__ytdlCaptionWatched",
              "__ytdlCapture"
            ]
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "build/**",
    "node_modules/**",
    ".output/**",
    ".wxt/**",
    "User Data/**",
    "patches/**",
    "scripts/bisect-*",
    "scripts/verify-download.mjs",
    "scripts/inspect-*",
    "scripts/check-*",
    "scripts/capture-logs.mjs",
    "scripts/reload-yt.mjs",
    "scripts/cherry-pick-*",
    "scripts/firefox-*",
    "scripts/dump-*",
    "scripts/cdp-*",
    "scripts/screenshot-*",
    "src/layers/processing/entrypoints/mux-worker/opfs.d.ts",
    ".claude/**",
    "user-profiles/**",
    ".verify-output/**"
  ],
  "overrides": [
    {
      "files": [
        "src/layers/youtube/entrypoints/iframe-mute.content.ts",
        "src/layers/youtube/entrypoints/sourcebuffer-capture/sourcebuffer-capture-patches.ts",
        "src/lib/youtube/movie-player.ts"
      ],
      "rules": {
        "typescript/unbound-method": "off"
      }
    },
    {
      "files": [
        "src/lib/youtube/format-filters.ts",
        "src/lib/download-options/helpers/audio-language-helpers.ts",
        "src/lib/youtube/movie-player.ts"
      ],
      "rules": {
        "house/positional-parameters": "off"
      }
    },
    {
      "files": [
        "src/layers/processing/entrypoints/mux-worker/emscripten-fs.d.ts"
      ],
      "rules": {
        "id-length": [
          "error",
          {
            "min": 3,
            "exceptions": [
              "_",
              "i",
              "j",
              "x",
              "y",
              "id",
              "to",
              "on",
              "ok",
              "T",
              "FS"
            ],
            "properties": "never"
          }
        ]
      }
    }
  ]
}
